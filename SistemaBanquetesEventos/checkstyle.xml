<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <!-- Regla propia 1: no permitir lineas mayores a 100 caracteres -->
    <module name="LineLength">
        <property name="max" value="100"/>
    </module>

    <module name="TreeWalker">

        <!-- 1. Los nombres de los metodos deben estar en minuscula -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="El metodo ''{0}'' debe estar escrito en minusculas."/>
        </module>

        <!-- 2. Los nombres de las clases deben iniciar con mayuscula -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="La clase ''{0}'' debe iniciar con mayuscula."/>
        </module>

        <!-- 3. Las variables locales deben estar en minuscula -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="La variable local ''{0}'' debe estar en minusculas."/>
        </module>

        <!-- Regla propia 2: no permitir imports con asterisco -->
        <module name="AvoidStarImport"/>

    </module>
</module>